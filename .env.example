CMS_PORT=3001
CMS_ADMIN_EMAIL=nirajchatri@gmail.com
CMS_CORS_ORIGIN=http://localhost:3000

# Required — generate: openssl rand -hex 32
CMS_ENCRYPTION_KEY=
JWT_SECRET=

# Google OAuth (Gmail send + Sign in with Google)
# Create credentials: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_MAIL_USER=your-gmail@gmail.com
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Legacy SMTP fallback (used only when Google mail OAuth is not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CheckOut.pe <your_sender@gmail.com>"

ENQUIRY_TO_EMAIL=niraj@checkout.pe

# SQL Server (optional locally — omit to use encrypted file store in data/content.enc)
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=checkout
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
