CMS_PORT=3001
CMS_ADMIN_EMAIL=nirajchatri@gmail.com
# Comma-separated browser origins allowed to call the API (chat, CMS, login).
# Production always also allows https://checkout.pe and https://www.checkout.pe.
CMS_CORS_ORIGIN=http://localhost:3000,https://checkout.pe,https://www.checkout.pe

# Required — generate: openssl rand -hex 32
CMS_ENCRYPTION_KEY=
JWT_SECRET=

# Google OAuth (Gmail send + Sign in with Google)
# Create credentials: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_MAIL_USER=your_sender@gmail.com
GOOGLE_REFRESH_TOKEN=

# Legacy SMTP fallback (used only when Google mail OAuth is not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CheckOut.pe <your_sender@gmail.com>"

ENQUIRY_TO_EMAIL=niraj@checkout.pe
INVESTOR_TO_EMAIL=checkout.pe@gmail.com

# SQL Server (optional locally — omit to use encrypted file store in data/content.enc)
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=checkout
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# XeroCode control DB (LLM_Config for OpenAI pitch-deck chat)
# If omitted, MSSQL_* host/user/password are reused with DATABASE=xerocode
XEROCODE_MSSQL_SERVER=
XEROCODE_MSSQL_PORT=1433
XEROCODE_MSSQL_DATABASE=xerocode
XEROCODE_MSSQL_USER=
XEROCODE_MSSQL_PASSWORD=
XEROCODE_MSSQL_ENCRYPT=false
XEROCODE_MSSQL_TRUST_SERVER_CERTIFICATE=true
