NODE_ENV=production
CMS_PORT=3001
CMS_ADMIN_EMAIL=nirajchatri@gmail.com
CMS_CORS_ORIGIN=https://checkout.pe

# Required — generate: openssl rand -hex 32
CMS_ENCRYPTION_KEY=
JWT_SECRET=

# SMTP — required for /admin OTP login
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CheckOut CMS <your_email@gmail.com>"

# SQL Server — same server as XeroCode-Backend (SQLSERVER_CONTROL_* also supported).
# IMPORTANT: quote passwords that contain $ or # (dotenv treats $ as variable expansion).
MSSQL_SERVER=172.31.11.96
MSSQL_PORT=1433
MSSQL_DATABASE=checkout
MSSQL_USER=sa
MSSQL_PASSWORD="your-password-here"
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_TLS_SERVER_NAME=localhost
MSSQL_CONNECTION_TIMEOUT=20000
MSSQL_REQUEST_TIMEOUT=20000

# XeroCode-style names (optional alternative to MSSQL_* above):
# SQLSERVER_CONTROL_HOST=172.31.11.96
# SQLSERVER_CONTROL_PORT=1433
# SQLSERVER_CONTROL_DATABASE=checkout
# SQLSERVER_CONTROL_USER=sa
# SQLSERVER_CONTROL_PASSWORD="your-password-here"
