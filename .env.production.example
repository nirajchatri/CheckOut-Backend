NODE_ENV=production
CMS_PORT=3001
CMS_ADMIN_EMAIL=nirajchatri@gmail.com
CMS_CORS_ORIGIN=https://checkout.pe

# Required — generate: openssl rand -hex 32
CMS_ENCRYPTION_KEY=
JWT_SECRET=

# SMTP — required for /admin OTP login
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CheckOut CMS <your_email@gmail.com>"

# Contact enquiry notifications
ENQUIRY_TO_EMAIL=niraj@checkout.pe

# SQL Server — required for live CMS content
# Use the private VPC IP if the API runs in the same AWS VPC as SQL Server.
MSSQL_SERVER=172.31.11.96
MSSQL_PORT=1433
MSSQL_DATABASE=checkout
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECTION_TIMEOUT=8000
MSSQL_REQUEST_TIMEOUT=15000
